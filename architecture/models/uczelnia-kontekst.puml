@startuml
title Cała uczelnia — kontekst aplikacji i właściciele danych
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
actor Kandydat
actor Student
actor Pracownik
component "Promocja i oferta\nprogramy i komunikaty" as Promo #DCEEFF
component "REKRUTACJA\nwdrożony moduł" as Rek #CDEDDC
component "Dziekanat / tok studiów\nwpisy, oceny, dyplomy" as Dziek <<projekt / system zewnętrzny>>
component "Organizacja dydaktyki\nECTS, przedmioty, sale" as Dyd <<projekt>>
component "LMS / współpraca cyfrowa" as LMS <<zewnętrzny>>
component "Biblioteka / repozytoria" as Bib <<zewnętrzny>>
component "Badania i granty\npublikacje, patenty" as Bad <<projekt>>
component "Finanse\nnależności, księgowanie" as Fin <<projekt>>
component "Kadry i płace" as Kad <<projekt>>
component "Akademiki i świadczenia" as Soc <<częściowo wdrożone>>
component "Dostępność i wsparcie" as Wsp <<projekt>>
component "Majątek / zamówienia" as Maj <<projekt>>
component "Zarządzanie / raportowanie" as BI <<projekt>>
component "Usługi wspólne\nIAM, komunikacja, obieg, audyt" as Shared <<częściowo wdrożone>>
Kandydat --> Rek
Promo --> Rek : katalog
Rek --> Dziek : obecnie eksport CSV przyjętych
Rek --> Soc : przyjęcie i odległość
Student --> Dziek
Pracownik --> Dyd
Dyd --> Dziek : program i plan
Dziek --> LMS : uprawnienia do kursów [projekt]
Dziek --> Bib : uprawnienia czytelnika [projekt]
Dziek --> Soc : status studenta [projekt]
Dziek --> Wsp
Dziek <--> Fin : należności / rozliczenia [projekt]
Kad --> Dyd : pracownicy i przydziały [projekt]
Maj --> Dyd : sale i wyposażenie [projekt]
Bad --> Bib : publikacje / repozytoria [projekt]
Rek --> BI : zestawienia
Dziek --> BI
Fin --> BI
Shared ..> Rek : lokalne role, poczta, audyt
Shared ..> Dziek : wspólna tożsamość [projekt]
legend bottom
  Zielony: działająca rekrutacja.
  Pozostałe obszary wyznaczają pełny kontekst uczelni.
  Relacje opisane [projekt] nie oznaczają uruchomionej integracji.
endlegend
@enduml
