@startuml
title Rekrutacja — komponenty i łączniki wdrożenia
left to right direction
skinparam componentStyle rectangle
component "PySide6 GUI\nClient + MainWindow" as UI #DCEEFF
component "DRF API\nadmissions.api / auth" as API #DCEEFF
component "Przypadki użycia\nservices / profiles / offers / housing" as Use #D9EFD8
component "Reguły\nstrategie I / II / PG" as Rules #FFF0C5
database "PostgreSQL\nmodele, ograniczenia,\nPL/pgSQL, audyt, liczniki" as DB
folder "Prywatne dokumenty\nwersje + SHA-256" as Files
component "Dyspozytor EmailDelivery" as Mail
cloud "SMTP / Geoportal / odnośniki PK" as Ext
component "Kopie i odtworzenie\nbackups.py" as Backup
UI --> API : JSON HTTP loopback\nHTTPS w LAN
API --> Use : wywołanie w transakcji
Use --> Rules : dane → Result
Use --> DB : Django ORM / SQL
Use --> Files : wersjonowany plik
Use --> Mail : zapis kolejki
Mail --> DB : pobranie / status próby
Mail --> Ext : SMTP
Use --> Ext : lokalizacja na żądanie
Backup --> DB : pg_dump / pg_restore
Backup --> Files : manifest i dokumenty
note bottom of DB
  pk_owner: migracje i administracja
  pk_app: ograniczone operacje aplikacji
  PostgreSQL dostępny wyłącznie lokalnie na serwerze
end note
@enduml
